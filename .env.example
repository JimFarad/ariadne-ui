# ARIADNE UI — frontend environment configuration
#
# Vite client variables are PUBLIC and embedded into the bundle.
# Never put secrets here. Everything below is safe for a browser.

# Base URL of the ARIADNE API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8801

# SOLARIS (Authentik) OIDC configuration.
# Discovery document: contains authorization/token/jwks endpoints.
VITE_OIDC_DISCOVERY_URL=https://sso.solaris-cloud.com/application/o/ariadne/.well-known/openid-configuration
# Public OIDC client id. Safe to expose in the SPA.
VITE_OIDC_CLIENT_ID=15a80914-6333-4c12-96b8-d852a9e3468d
# Redirect URI registered with SOLARIS for this SPA. Defaults to
# `${window.location.origin}/auth/callback` when empty.
VITE_OIDC_REDIRECT_URI=http://localhost:5174/auth/callback
# Scopes (space separated). `offline_access` is required for a refresh token.
VITE_OIDC_SCOPES=openid profile email offline_access userinfo.id groups.org userinfo.identity.verify
# Where to send the user after a SOLARIS-initiated logout.
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=

# Application environment tag reported in Ariadne-Client-Environment header.
VITE_APP_ENV=development
